{
    "name": "nenuadrian/secretrepublic",
    "type": "project",
    "description": "Secret Republic - open source browser-based cyber security RPG built with PHP and FuelPHP",
    "keywords": [
        "browser-game",
        "security-game",
        "cyber-security",
        "rpg",
        "php",
        "fuelphp",
        "mysql",
        "game"
    ],
    "license": "MIT",
    "homepage": "https://nenuadrian.github.io/secret-republic-browser-based-cyber-security-rpg-v4/",
    "support": {
        "issues": "https://github.com/nenuadrian/secret-republic-browser-based-cyber-security-rpg-v4/issues",
        "source": "https://github.com/nenuadrian/secret-republic-browser-based-cyber-security-rpg-v4",
        "docs": "https://nenuadrian.github.io/secret-republic-browser-based-cyber-security-rpg-v4/"
    },
    "require": {
        "php": "^8.3",
        "ext-mysqli": "*",
        "ext-pdo_mysql": "*",
        "ext-sqlite3": "*",
        "composer/installers": "^2.3",
        "fuel/core": "dev-1.9/develop",
        "fuel/email": "dev-1.9/develop",
        "fuel/parser": "dev-1.9/develop",
        "jbbcode/jbbcode": "^1.4",
        "thunderer/shortcode": "^0.7.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "vendor-dir": "fuel/vendor",
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "composer/installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "installer-paths": {
            "fuel/{$name}": [
                "fuel/core"
            ]
        }
    },
    "scripts": {
        "lint": "find fuel/app fuel/packages/hacker fuel/packages/messages fuel/packages/globaljs public_html tests docker -name '*.php' -not -path 'fuel/app/vendor/*' -print0 | xargs -0 -n1 -P4 php -d display_errors=stderr -d error_reporting=-1 -l 2>&1 >/dev/null | (! grep .)",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
