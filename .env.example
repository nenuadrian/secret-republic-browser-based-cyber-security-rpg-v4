# Copy to .env and adjust before `docker compose up`.
APP_PORT=8080
FUEL_ENV=production
DB_NAME=secretrepublic
DB_USER=secretrepublic
DB_PASSWORD=secretrepublic
DB_ROOT_PASSWORD=change-me-root

# Password-hashing salt. Set ONCE before the first account is created;
# changing it later invalidates every existing password.
SR_SALT=
# Secret used in cron URLs: /cron/rankings/<SR_CRON_HASH>
SR_CRON_HASH=
# Session encryption key, 64 hex chars: `openssl rand -hex 32`.
# Without it a random key is generated per container (players are logged out on rebuild).
SR_CRYPT_KEY=
